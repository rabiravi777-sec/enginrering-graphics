import numpy as np
import matplotlib.pyplot as plt

# Center of the circles
h = 0
k = 0

# Radius values
r_values = [20, 40, 60, 80, 100]

# Angle values
theta = np.linspace(0, 2 * np.pi, 500)

# Draw circles
for r in r_values:
    x = h + r * np.cos(theta)
    y = k + r * np.sin(theta)

    plt.plot(x, y, label=f"r = {r}")

# Set equal scale
plt.axis("equal")

# Labels and title
plt.xlabel("X")
plt.ylabel("Y")
plt.title("Star Pattern using Concentric Circles")

# Grid and legend
plt.grid(True)
plt.legend()

# Display graph
plt.show()
