import numpy as np
import matplotlib.pyplot as plt

# Values of x
x = np.linspace(-10, 10, 100)

# Values of c
c_values = [-3, -2, -1, 0, 1, 2, 3]

# Draw parallel lines
for c in c_values:
    y = 2*x + c
    plt.plot(x, y, label=f"y = 2x + ({c})")

# Add X and Y axes
plt.axhline(0)
plt.axvline(0)

# Labels and title
plt.xlabel("X")
plt.ylabel("Y")
plt.title("Family of Parallel Lines: y = 2x + c")

# Grid and legend
plt.grid(True)
plt.legend()

# Show graph
plt.show()
