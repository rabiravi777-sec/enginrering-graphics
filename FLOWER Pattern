import numpy as np
import matplotlib.pyplot as plt

# Center of flower
hc = 0
kc = 0

# Distance from center
R = 100

# Radius of each circle
r = 30

# Number of circles
n = 12

# Angle for drawing circles
theta = np.linspace(0, 2 * np.pi, 300)

# Draw flower pattern
for i in range(n):

    # Calculate center of each circle
    hi = hc + R * np.cos(2 * np.pi * i / n)
    ki = kc + R * np.sin(2 * np.pi * i / n)

    # Circle equation
    x = hi + r * np.cos(theta)
    y = ki + r * np.sin(theta)

    plt.plot(x, y)

# Draw center circle
x = hc + r * np.cos(theta)
y = kc + r * np.sin(theta)
plt.plot(x, y)

# Equal scale
plt.axis("equal")

# Labels and title
plt.xlabel("X")
plt.ylabel("Y")
plt.title("Flower Pattern")

# Grid
plt.grid(True)

# Display
plt.show()
